rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // News collection - open read for all users, write for app users
    match /news/{newsId} {
      allow read: if true;
      allow write: if true;
    }

    // Reels collection - open read for all users, write for app users
    match /reels/{reelId} {
      allow read: if true;
      allow write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Comments collection
    match /comments/{commentId} {
      allow read, write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
